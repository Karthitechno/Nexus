{
  "info": {
    "_postman_id": "c1f7b110-82a1-45d2-9b6d-nexus-paypal-official",
    "name": "PayPal REST APIs",
    "description": "Verified Official PayPal REST APIs Collection for NEXUS Agent Tool Registry",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
