          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://api-m.sandbox.paypal.com/v1/notifications/webhooks",
              "protocol": "https",
              "host": ["api-m", "sandbox", "paypal", "com"],
              "path": ["v1", "notifications", "webhooks"]
            },
            "description": "Lists all configured webhook subscription listeners."
          }
        },
        {
          "name": "Create Webhook",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": {
              "raw": "https://api-m.sandbox.paypal.com/v1/notifications/webhooks",
              "protocol": "https",
              "host": ["api-m", "sandbox", "paypal", "com"],
              "path": ["v1", "notifications", "webhooks"]
            },
            "description": "Registers a new webhook URL listener to receive event notifications.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://example.com/webhook\",\n  \"event_types\": [{\"name\": \"*\"}]\n}"
            }
          }
        }
      ]
    }
  ]
