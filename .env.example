# ==========================================
# NEXUS Environment Configuration Template
# Copy this file to .env and fill in your values
# ==========================================

# Google Gemini API
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-2.5-flash"

# PayPal Sandbox Credentials (from developer.paypal.com)
PAYPAL_CLIENT_ID="your_paypal_sandbox_client_id_here"
PAYPAL_CLIENT_SECRET="your_paypal_sandbox_client_secret_here"
PAYPAL_BASE_URL="https://api-m.sandbox.paypal.com"

# LangSmith Observability (Optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY="optional_langsmith_key"
LANGCHAIN_PROJECT="nexus"

# Backend Server Configuration
NEXUS_PORT=8000
LOG_LEVEL="INFO"

# Redis Cache & State Store (Optional - falls back to in-memory)
REDIS_URL="redis://localhost:6379/0"
